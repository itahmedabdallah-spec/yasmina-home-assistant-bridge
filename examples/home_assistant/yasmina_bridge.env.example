# Copy to /config/yasmina_bridge.env inside Home Assistant.
# Device configuration only. Do not put HA/Yango tokens here.
YASMINA_TV_IP=192.0.2.10
YASMINA_TV_ADB_PORT=5555
YASMINA_TV_MAC=00:00:00:00:00:00
YASMINA_TV_BROADCAST=255.255.255.255
YASMINA_BUNDLE_DIR=/config/yasmina_bundle
YASMINA_TV_SOCKET=/config/.yasmina_tv_worker.sock
YASMINA_TV_WORKER_PATH=/config/yasmina_tv_worker.py
YASMINA_APP_YOUTUBE_PACKAGE=com.google.android.youtube.tv
YASMINA_APP_SHAHID_PACKAGE=net.mbc.shahidTV
YASMINA_APP_WATCHIT_PACKAGE=com.watchit.vod
YASMINA_APP_YANGO_PACKAGE=com.yango.saft.tv
