# Public provider
YASMINA_PUBLIC_HOST=home.example.com
YASMINA_LISTEN_PORT=8794
YASMINA_DEVICE_PREFIX=yasmina-home
YASMINA_OWNER_ID=local-owner
YASMINA_OAUTH_CLIENT_ID=yasmina-home-native
YASMINA_OAUTH_REDIRECT=https://social.yango.com/broker/redirect

# Home Assistant inventory (1-6 lights)
YASMINA_LIGHT_GROUP_ENTITY=light.living_room
YASMINA_LIGHT_ENTITIES=light.living_room_1,light.living_room_2,light.living_room_3
YASMINA_LIGHT_GROUP_NAME=Living room lights
YASMINA_BULB_NAME_PREFIX=Living room bulb
YASMINA_TV_ENTITY=media_player.android_tv
YASMINA_VOICE_MUTE_ENTITY=switch.voice_assistant_mute

# Android TV / ADB / Wake-on-LAN
YASMINA_TV_IP=192.0.2.10
YASMINA_TV_ADB_PORT=5555
YASMINA_TV_MAC=00:00:00:00:00:00
YASMINA_TV_BROADCAST=255.255.255.255
YASMINA_HA_CONFIG_DIR=/config
YASMINA_BUNDLE_DIR=/config/yasmina_bundle
YASMINA_TV_SOCKET=/config/.yasmina_tv_worker.sock
YASMINA_TV_WORKER_PATH=/config/yasmina_tv_worker.py

# Android TV application packages
YASMINA_APP_YOUTUBE_PACKAGE=com.google.android.youtube.tv
YASMINA_APP_SHAHID_PACKAGE=net.mbc.shahidTV
YASMINA_APP_WATCHIT_PACKAGE=com.watchit.vod
YASMINA_APP_YANGO_PACKAGE=com.yango.saft.tv
